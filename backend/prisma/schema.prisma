generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [ltree, pg_trgm]
}

// enums
enum TaxonomyRank {
  kingdom
  phylum
  taxonomicClass
  order
  family
  genus
  species
  subspecies
  variety
  forma
}

enum PlantGroup {
  angiosperm
  gymnosperm
  fern
}

enum PublishStatus {
  draft
  published
  archived
}

enum UserRole {
  admin
  editor
  user
}

enum ImageStatus {
  pending
  approved
  rejected
}

enum UserStatus {
  active
  inactive
}

// taxon core
model Taxon {
  id            Int          @id
  slug          String       @unique @db.Text
  
  // identification
  canonicalName  String       @map("canonical_name") @db.Text
  scientificName String       @map("scientific_name") @db.Text
  author         String?      @db.Text
  vietnameseName String?      @map("vietnamese_name") @db.Text
  primaryImageUrl String?     @map("primary_image_url") @db.Text
  
  // classification
  rank           TaxonomyRank
  plantGroup     PlantGroup?  @map("plant_group")
  parentId       Int?         @map("parent_id")
  path           Unsupported("ltree")?
  
  // status
  status             PublishStatus @default(draft)
  hasVietnamRecord   Boolean       @default(false) @map("has_vietnam_record")
  
  // descriptions
  description        String?  @db.Text
  descriptionLang    String?  @default("vi") @map("description_lang") @db.Text
  habit              String?  @db.Text
  leaf               String?  @db.Text
  reproduction       String?  @db.Text
  phenology          String?  @db.Text
  value              String?  @db.Text
  distributionText   String?  @map("distribution_text") @db.Text
  note               String?  @db.Text

  // search
  searchVector Unsupported("tsvector")?     @map("search_vector")
  
  sourceName           String?  @map("source_name") @db.Text
  externalId           String?  @map("external_id") @db.Text
  orderInBook          String?  @map("order_in_book") @db.Text
  rawDescriptionInBook String?  @map("raw_description_in_book") @db.Text

  // timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // relations
  parent        Taxon?         @relation("TaxonHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children      Taxon[]        @relation("TaxonHierarchy")
  synonyms      TaxonSynonym[]
  commonNames   TaxonCommonName[]
  images        TaxonImage[]
  provinces     TaxonProvince[]
  bookmarks     Bookmark[]

  @@unique([scientificName])
  @@index([rank])
  @@index([status])
  @@index([parentId])
  @@index([plantGroup])
  @@index([scientificName(ops: raw("gin_trgm_ops"))], map: "taxon_scientific_name_trgm_idx", type: Gin)
  @@index([vietnameseName(ops: raw("gin_trgm_ops"))], map: "taxon_vietnamese_name_trgm_idx", type: Gin)
  @@index([scientificName(ops: raw("text_pattern_ops"))], map: "taxon_scientific_name_prefix_idx")
  @@index([searchVector], map: "taxon_search_vector_idx", type: Gin)
  @@map("taxon")
}

// supplementary names
model TaxonSynonym {
  id             Int      @id @default(autoincrement())
  taxonId        Int?     @map("taxon_id")
  
  scientificName String   @map("scientific_name") @db.Text
  sourceName     String?  @map("source_name") @db.Text
  externalId     String?  @map("external_id") @db.Text

  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  taxon Taxon? @relation(fields: [taxonId], references: [id], onDelete: Cascade)

  @@unique([taxonId, scientificName])
  @@index([taxonId])
  @@index([scientificName(ops: raw("gin_trgm_ops"))], map: "synonym_name_trgm_idx", type: Gin)
  @@map("taxon_synonym")
}

model TaxonCommonName {
  id         Int     @id @default(autoincrement())
  taxonId    Int     @map("taxon_id")
  
  name       String
  language   String? @db.VarChar(50) // BCP 47 (vi, en...)
  isPrimary  Boolean @default(false) @map("is_primary")
  regionNote String? @map("region_note") @db.Text
  source     String?

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  taxon Taxon @relation(fields: [taxonId], references: [id], onDelete: Cascade)

  @@unique([taxonId, name, language])
  @@index([taxonId])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "common_name_trgm_idx", type: Gin)
  @@map("taxon_common_name")
}

// media and sources
model TaxonImage {
  id             Int         @id @default(autoincrement())
  taxonId        Int         @map("taxon_id")

  url            String      @db.Text
  storageKey     String?     @unique @map("storage_key")
  externalSource String?     @map("external_source") 
  externalId     String?     @map("external_id")

  caption        String?     @db.Text
  blurHash       String?     @map("blur_hash") @db.VarChar(100)
  width          Int?
  height         Int?
  author         String?     @db.Text
  license        String?     @db.Text

  isPrimary      Boolean     @default(false) @map("is_primary")
  sortOrder      Int         @default(0) @map("sort_order")
  status         ImageStatus @default(pending)

  // Review fields
  recordNote     String?     @map("record_note") @db.Text
  reviewedAt     DateTime?   @map("reviewed_at") @db.Timestamptz()
  reviewedBy     String?     @map("reviewed_by") @db.Uuid

  contributorId  String?     @map("contributor_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  taxon       Taxon  @relation(fields: [taxonId], references: [id], onDelete: Cascade)
  contributor User?  @relation(fields: [contributorId], references: [id], onDelete: SetNull)
  reviewer    User?  @relation("ImageReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  likes       TaxonImageLike[]

  @@unique([taxonId, externalSource, externalId])
  @@index([taxonId])
  @@index([isPrimary])
  @@index([sortOrder])
  @@index([contributorId])
  @@map("taxon_image")
}


// geography
model Province {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)        

  taxa TaxonProvince[]

  @@map("province")
}

model TaxonProvince {
  taxonId    Int    @map("taxon_id")
  provinceId Int    @map("province_id")

  taxon    Taxon    @relation(fields: [taxonId], references: [id], onDelete: Cascade)
  province Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  @@id([taxonId, provinceId])
  @@index([provinceId])
  @@map("taxon_province")
}

// users
model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String?   @map("password_hash")
  displayName  String?   @map("display_name")
  avatarUrl    String?   @map("avatar_url")
  role         UserRole  @default(user)
  status       UserStatus @default(active)

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  accounts       Account[]
  bookmarks      Bookmark[]
  uploadedImages TaxonImage[]
  reviewedImages TaxonImage[]   @relation("ImageReviewer")
  refreshTokens  RefreshToken[]
  imageLikes     TaxonImageLike[]

  @@map("user")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.Text
  userAgent String?  @map("user_agent") @db.Text
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

model Account {
  id                String @id @default(uuid()) @db.Uuid
  userId            String @map("user_id") @db.Uuid
  provider          String @db.VarChar(50)
  providerAccountId String @map("provider_account_id") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.Uuid
  taxonId   Int      @map("taxon_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  taxon Taxon @relation(fields: [taxonId], references: [id], onDelete: Cascade)

  @@unique([userId, taxonId])
  @@map("bookmark")
}

model TaxonImageLike {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.Uuid
  imageId   Int      @map("image_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  image TaxonImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([userId, imageId])
  @@index([userId])
  @@index([imageId])
  @@map("taxon_image_like")
}

